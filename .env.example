# Space Works Inventory configuration. Copy to .env for local development.
# Names only: never commit real values. Production checks: npm run production:check.

# --- Database (PostgreSQL 16) ---
# Local services: `docker compose up -d` starts PostgreSQL on 5440.
DATABASE_URL=postgresql://swi:swi_dev_password@localhost:5440/swi_dev
# Direct (non-pooled) connection for migrations; defaults to DATABASE_URL.
DIRECT_URL=
# Disposable database for `npm run test:integration` (its data is wiped).
TEST_DATABASE_URL=postgresql://swi:swi_dev_password@localhost:5440/swi_test

# --- Auth ---
# openssl rand -hex 32
AUTH_SECRET=
# The public origin, no trailing slash (identical values).
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Optional: this email can also open /admin (the setup wizard's account always can).
SUPER_ADMIN_EMAIL=
# "open" shows "Create an account" on the sign-in page (spaces still need an
# invitation or self-join); "invite" (default) hides it. /admin overrides it.
ACCOUNT_SIGNUP=

# --- Encryption keys (openssl rand -base64 32). Losing them locks out MFA and stored secrets. ---
MFA_ENCRYPTION_KEY=
# Payment provider and webhook signing secrets (falls back to a subkey of MFA_ENCRYPTION_KEY).
INTEGRATION_ENCRYPTION_KEY=
# Stable across builds and replicas (Server Actions).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- Operations ---
# Optional memory tuning for a 512 MB container; leave unset for local builds.
# NODE_OPTIONS=--max-old-space-size=384
# Protects POST /api/internal/outbox and /api/internal/jobs (cron services).
CRON_SECRET=
HEALTHCHECK_SECRET=
# Redis: rate limits and the BullMQ worker/beat. Without it in development,
# rate limits use memory and JOBS_INPROCESS=true runs the jobs in the web process.
REDIS_URL=redis://localhost:6395
JOBS_INPROCESS=
JOBS_HEALTH_PORT=
QUEUE_OUTBOX_CONCURRENCY=
QUEUE_SCHEDULED_CONCURRENCY=

# --- Private object storage (photos, evidence). Silo locally, R2/S3 in the cloud. ---
# Without S3_BUCKET in development, files are written to .data/storage.
S3_BUCKET=swi-dev
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY_ID=swidev
S3_SECRET_ACCESS_KEY=swi_dev_storage_pw
S3_FORCE_PATH_STYLE=1
UPLOAD_MAX_BYTES=

# --- Email (bootstrap fallback; /admin settings override it) ---
# Without SMTP in development, emails are written to .data/mail/.
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_SERVICE=
SMTP_USER=
SMTP_PASSWORD=
# Local Mailpit only (docker compose): SMTP_HOST=localhost SMTP_PORT=1025.
SMTP_ALLOW_UNAUTHENTICATED=
OUTBOX_RETENTION_DAYS=

# --- Outbound webhooks ---
# Lets webhooks reach private network addresses (development and trusted LANs only).
ALLOW_PRIVATE_WEBHOOK_TARGETS=

# --- Proxies ---
# Header that carries the client IP from your reverse proxy: x-real-ip (Caddy), x-forwarded-for (+ hops), cf-connecting-ip.
TRUSTED_PROXY_IP_HEADER=
TRUSTED_PROXY_HOPS=
ALLOWED_ACTION_ORIGINS=

# --- Split hosting (website and API on two hosts; see docs/DEPLOYMENT_SPLIT.md) ---
DEPLOYMENT_MODE=
BACKEND_ORIGIN=
NEXT_PUBLIC_BACKEND_ORIGIN=
FRONTEND_GATEWAY_SECRET=
FRONTEND_TRUSTED_IP_HEADER=

# --- Demo data: DEMO_PASSWORD=... npm run db:seed:demo ---
DEMO_PASSWORD=
